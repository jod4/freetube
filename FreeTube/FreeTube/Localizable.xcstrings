        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use “Download video” in a video's … menu to save it for offline viewing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa «Descargar vídeo» en el menú … de un vídeo para guardarlo y verlo sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez « Télécharger la vidéo » dans le menu … d’une vidéo pour l’enregistrer et la regarder hors ligne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте «Скачать видео» в меню … видео, чтобы сохранить его для офлайн-просмотра."
          }
        }
      }
    },
    "Version read failed: %@" : {
